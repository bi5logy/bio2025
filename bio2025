<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>생명과학Ⅰ 수업 마무리</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Pretendard:wght@400;600;700&display=swap');
        body { font-family: 'Pretendard', sans-serif; background-color: #f1f5f9; }
        .chat-container { height: calc(100vh - 180px); }
        .bubble { max-width: 85%; border-radius: 1rem; position: relative; }
        .bubble-bot { background-color: white; color: #1e293b; border-bottom-left-radius: 0; border: 1px solid #e2e8f0; }
        .bubble-user { background-color: #2563eb; color: white; border-bottom-right-radius: 0; }
        .loading-dots span { animation: blink 1.4s infinite both; }
        .loading-dots span:nth-child(2) { animation-delay: .2s; }
        .loading-dots span:nth-child(3) { animation-delay: .4s; }
        @keyframes blink { 0% { opacity: .2; } 20% { opacity: 1; } 100% { opacity: .2; } }
        .hidden-mode { display: none !important; }
    </style>
</head>
<body class="flex flex-col h-screen overflow-hidden">

    <!-- Header -->
    <header class="bg-white border-b px-6 py-4 flex justify-between items-center shadow-sm shrink-0 z-10">
        <div class="flex items-center gap-3">
            <div class="bg-blue-100 p-2 rounded-lg text-blue-600 text-xl">🧬</div>
            <div>
                <h1 class="text-lg font-bold text-slate-800 leading-tight">생명과학Ⅰ 성찰 도우미</h1>
                <p id="mode-status" class="text-[10px] text-slate-400 font-medium uppercase tracking-wider">Student Mode Interface</p>
            </div>
        </div>
        <button id="reset-btn" class="text-xs px-3 py-2 text-slate-500 hover:bg-slate-50 border border-slate-200 rounded-md transition">초기화</button>
    </header>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col md:flex-row gap-4 p-4 max-w-7xl mx-auto w-full overflow-hidden relative">
        
        <!-- Chat Section (Students) -->
        <section id="chat-section" class="flex-1 flex flex-col bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden transition-all duration-300">
            <div id="chat-window" class="chat-container overflow-y-auto p-6 space-y-6">
                <div class="flex justify-start">
                    <div class="bubble bubble-bot p-4 shadow-sm text-sm leading-relaxed">
                        안녕! 생명과학 수업을 통해 여러분이 얼마나 성장했는지 기록해보는 시간이에요. 😊<br><br>
                        먼저 여러분의 **학번과 이름**을 알려줄래요?
                    </div>
                </div>
            </div>

            <!-- Input Area -->
            <div class="p-4 border-t bg-slate-50">
                <form id="chat-form" class="flex gap-2">
                    <input type="text" id="user-input" placeholder="메시지를 입력하세요..." class="flex-1 px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white transition-all text-sm" autocomplete="off">
                    <button type="submit" id="send-btn" class="bg-blue-600 text-white px-5 py-3 rounded-xl font-semibold hover:bg-blue-700 transition shadow-md active:scale-95">보내기</button>
                </form>
            </div>
        </section>

        <!-- Teacher Dashboard (Hidden by default) -->
        <aside id="teacher-aside" class="w-full md:w-96 flex flex-col bg-slate-800 text-white rounded-2xl shadow-2xl border border-slate-700 p-5 overflow-hidden hidden-mode">
            <div class="flex items-center justify-between mb-6">
                <h2 class="font-bold text-blue-400 flex items-center gap-2">
                    <span>🛡️</span> 교사 관리 패널
                </h2>
                <span class="text-[10px] bg-slate-700 px-2 py-1 rounded">bi5logy@gmail.com</span>
            </div>
            
            <div class="space-y-4 mb-6">
                <div>
                    <label class="block text-[11px] font-bold text-slate-400 mb-1 uppercase">Google Apps Script URL</label>
                    <input type="password" id="sheet-url-input" placeholder="URL을 입력하고 Enter" class="w-full text-xs p-2.5 rounded bg-slate-900 border border-slate-700 focus:border-blue-500 outline-none transition">
                </div>
            </div>

            <div class="flex-1 flex flex-col overflow-hidden bg-slate-900 rounded-xl border border-slate-700">
                <div class="p-3 border-b border-slate-800 flex justify-between items-center bg-slate-800/50">
                    <span class="text-xs font-bold text-slate-300">데이터 수집 및 초안 생성</span>
                    <div id="status-dot" class="w-2 h-2 rounded-full bg-slate-600"></div>
                </div>
                <div id="draft-container" class="flex-1 overflow-y-auto p-4 space-y-4">
                    <div class="text-slate-500 italic text-xs text-center py-20">
                        학생의 답변이 종료되면<br>이곳에 기초 데이터와 세특 초안이 나타납니다.
                    </div>
                </div>
            </div>
            
            <div id="save-status" class="mt-4 hidden p-2.5 bg-green-500/10 text-green-400 text-[11px] text-center rounded-lg border border-green-500/20">
                ✅ 구글 시트에 자동 저장되었습니다.
            </div>
            
            <button id="copy-btn" class="mt-4 w-full bg-blue-600 text-white py-3 rounded-xl font-bold hover:bg-blue-500 transition hidden shadow-lg shadow-blue-900/20">
                생기부 문구 복사
            </button>
        </aside>

        <!-- Admin Toggle Button -->
        <button id="teacher-lock" class="absolute bottom-6 right-6 w-10 h-10 bg-slate-200 hover:bg-white rounded-full flex items-center justify-center opacity-20 hover:opacity-100 transition-all shadow-lg z-50 border border-slate-300">
            <svg id="lock-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        </button>
    </main>

    <script>
        const apiKey = ""; 
        let googleScriptUrl = localStorage.getItem('bi5logy_sheet_url') || "";

        const chatWindow = document.getElementById('chat-window');
        const chatForm = document.getElementById('chat-form');
        const userInput = document.getElementById('user-input');
        const draftContainer = document.getElementById('draft-container');
        const copyBtn = document.getElementById('copy-btn');
        const resetBtn = document.getElementById('reset-btn');
        const teacherLock = document.getElementById('teacher-lock');
        const teacherAside = document.getElementById('teacher-aside');
        const modeStatus = document.getElementById('mode-status');
        const sheetUrlInput = document.getElementById('sheet-url-input');
        const saveStatus = document.getElementById('save-status');
        const statusDot = document.getElementById('status-dot');

        if (googleScriptUrl) sheetUrlInput.value = googleScriptUrl;

        let conversationHistory = [];
        let isFinished = false;
        let isTeacherMode = false;
        const TEACHER_PASSWORD = "0000"; 

        const systemPrompt = `당신은 고등학교 생명과학Ⅰ 교사입니다. 학생의 성찰을 기록으로 남기는 과정을 돕습니다.

**대화 수칙**:
1. **반드시 한 번에 하나의 질문만 하세요.**
2. 질문 흐름:
   - 학번과 이름 확인
   - 가장 기억에 남는 대단원/주제 선정
   - 해당 주제를 통해 새롭게 알게 된 사실이나 이전의 오해
   - 이해가 안 되었을 때 본인이 했던 노력 (질문, 실험, 자료 검색 등)
   - 이 내용이 본인의 진로(장래희망)와 어떻게 연결되는지
   - 본인이 이 수업을 통해 스스로 가장 칭찬하고 싶은 점
3. 학생의 답변에 적극적으로 공감하고 필요시 구체적인 답변을 유도하는 꼬리 질문을 던지세요.
4. 모든 정보가 수집되면 마지막에 반드시 "[완료] 질문이 끝났습니다. 수고하셨습니다."라고 답변을 마무리하세요.
5. 학생에게 보여줄 채팅 내용에는 절대로 세특 문구를 포함하지 마세요.`;

        teacherLock.addEventListener('click', () => {
            if (!isTeacherMode) {
                const pw = prompt("관리자 암호를 입력하세요.");
                if (pw === TEACHER_PASSWORD) {
                    isTeacherMode = true;
                    teacherAside.classList.remove('hidden-mode');
                    modeStatus.innerText = "Teacher Management Interface (ADMIN)";
                    modeStatus.className = "text-[10px] text-blue-500 font-bold uppercase tracking-wider";
                    document.getElementById('lock-icon').innerHTML = '<path d="M7 11V7a5 5 0 0 1 10 0v4"></path><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M12 15v3"></path>';
                } else if(pw !== null) alert("암호가 올바르지 않습니다.");
            } else {
                isTeacherMode = false;
                teacherAside.classList.add('hidden-mode');
                modeStatus.innerText = "Student Mode Interface";
                modeStatus.className = "text-[10px] text-slate-400 font-medium uppercase tracking-wider";
                document.getElementById('lock-icon').innerHTML = '<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>';
            }
        });

        sheetUrlInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                googleScriptUrl = e.target.value;
                localStorage.setItem('bi5logy_sheet_url', googleScriptUrl);
                alert("구글 시트 URL이 저장되었습니다.");
            }
        });

        async function callGemini(message) {
            const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
            
            const fullPrompt = `이전 대화 내역: ${JSON.stringify(conversationHistory)}\n\n학생의 이번 답변: ${message}\n\n시스템 가이드라인: ${systemPrompt}\n\n추가 지침: 학생의 데이터가 충분히 모였다고 판단되면, 답변 끝에 반드시 '[분석 데이터]'와 '[세특 문구]'라는 태그를 사용하여 각각 핵심 요약과 500자 이내의 생기부 문구를 작성해 주세요. 학생용 대화창에는 이 태그 이후의 내용은 출력되지 않으니 안심하고 작성하세요.`;

            const payload = {
                contents: [{ parts: [{ text: fullPrompt }] }]
            };

            let retries = 5;
            while (retries > 0) {
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const result = await response.json();
                    return result.candidates?.[0]?.content?.parts?.[0]?.text;
                } catch (error) {
                    retries--;
                    if (retries === 0) throw error;
                    await new Promise(res => setTimeout(res, 1000));
                }
            }
        }

        async function saveToGoogleSheet(data) {
            if (!googleScriptUrl) return;
            try {
                statusDot.classList.replace('bg-slate-600', 'bg-yellow-400');
                await fetch(googleScriptUrl, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                saveStatus.classList.remove('hidden');
                statusDot.classList.replace('bg-yellow-400', 'bg-green-500');
            } catch (err) { 
                console.error(err);
                statusDot.classList.replace('bg-yellow-400', 'bg-red-500');
            }
        }

        function addMessage(text, isUser = false) {
            // 학생 화면에서는 AI의 분석 태그 이후 내용을 가림
            const displayChat = isUser ? text : text.split('[분석 데이터]')[0].split('[세특 문구]')[0].trim();
            const div = document.createElement('div');
            div.className = `flex ${isUser ? 'justify-end' : 'justify-start'}`;
            div.innerHTML = `<div class="bubble ${isUser ? 'bubble-user' : 'bubble-bot'} p-4 shadow-sm text-sm leading-relaxed">${displayChat.replace(/\n/g, '<br>')}</div>`;
            chatWindow.appendChild(div);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        function showLoading() {
            const div = document.createElement('div');
            div.id = 'loading';
            div.className = 'flex justify-start';
            div.innerHTML = `<div class="bubble bubble-bot p-4 loading-dots text-xs">선생님이 답변을 읽고 있습니다<span>.</span><span>.</span><span>.</span></div>`;
            chatWindow.appendChild(div);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        function removeLoading() {
            const loader = document.getElementById('loading');
            if (loader) loader.remove();
        }

        function extractTagContent(text, tag) {
            const regex = new RegExp(`\\[${tag}\\]([\\s\\S]*?)(?=\\[|$)`);
            const match = text.match(regex);
            return match ? match[1].trim() : null;
        }

        function processTeacherData(text) {
            const analysis = extractTagContent(text, '분석 데이터');
            const draft = extractTagContent(text, '세특 문구');

            if (analysis || draft) {
                draftContainer.innerHTML = '';
                
                if (analysis) {
                    const analysisEl = document.createElement('div');
                    analysisEl.className = "p-3 bg-slate-800 border border-slate-700 rounded-lg text-slate-300 text-[11px] leading-normal";
                    analysisEl.innerHTML = `<div class="text-blue-400 font-bold mb-1">🔍 기초 데이터 분석</div>${analysis.replace(/\n/g, '<br>')}`;
                    draftContainer.appendChild(analysisEl);
                }

                if (draft) {
                    const draftEl = document.createElement('div');
                    draftEl.className = "p-3 bg-blue-900/30 border border-blue-500/30 rounded-lg text-blue-100 text-xs leading-relaxed";
                    draftEl.innerHTML = `<div class="text-blue-400 font-bold mb-1">✍️ 세특 문구 초안</div>${draft.replace(/\n/g, '<br>')}`;
                    draftContainer.appendChild(draftEl);
                    copyBtn.classList.remove('hidden');
                }

                if (text.includes("[완료]")) {
                    isFinished = true;
                    const studentInfo = conversationHistory[0]?.content || "Unknown";
                    saveToGoogleSheet({
                        student: studentInfo,
                        timestamp: new Date().toLocaleString(),
                        teacher_email: "bi5logy@gmail.com",
                        analysis: analysis,
                        draft: draft,
                        full_chat: conversationHistory.map(h => `${h.role}: ${h.content}`).join('\n')
                    });
                }
            }
        }

        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const text = userInput.value.trim();
            if (!text || isFinished) return;

            addMessage(text, true);
            userInput.value = '';
            showLoading();

            try {
                const response = await callGemini(text);
                removeLoading();
                addMessage(response);
                
                conversationHistory.push({ role: 'student', content: text });
                conversationHistory.push({ role: 'teacher', content: response });
                
                processTeacherData(response);

                if (response.includes("[완료]")) {
                    userInput.disabled = true;
                    userInput.placeholder = "성찰이 완료되었습니다. 고생했어요!";
                    document.getElementById('send-btn').style.opacity = '0.5';
                }
            } catch (err) {
                removeLoading();
                addMessage("네트워크 오류가 발생했습니다. 잠시 후 다시 입력해 주세요.");
            }
        });

        copyBtn.addEventListener('click', () => {
            const draftText = draftContainer.querySelector('div:last-child').innerText.replace('✍️ 세특 문구 초안', '').trim();
            const textarea = document.createElement('textarea');
            textarea.value = draftText;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            
            const originText = copyBtn.innerText;
            copyBtn.innerText = "✅ 클립보드 복사됨";
            setTimeout(() => copyBtn.innerText = originText, 2000);
        });

        resetBtn.addEventListener('click', () => {
            if(confirm("모든 데이터를 초기화하고 새로 시작하시겠습니까?")) location.reload();
        });
    </script>
</body>
</html>
